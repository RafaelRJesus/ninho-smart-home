# Copiar para deploy/oracle/.env na VM e preencher. Nunca commitar o .env real.
# Gerar segredos com:  openssl rand -hex 32   (AUTH_SECRET: openssl rand -hex 32 já dá 64 caracteres)

# Endereço público. Sem domínio próprio, use o IP com traços + .sslip.io
DOMAIN=150-1-2-3.sslip.io
APP_URL=https://150-1-2-3.sslip.io
CORS_ORIGIN=https://150-1-2-3.sslip.io

# Banco (Postgres na própria VM). Use só caracteres hexadecimais na senha.
POSTGRES_USER=ninho
POSTGRES_DB=ninho
POSTGRES_PASSWORD=troque_por_openssl_rand_hex_32
DATABASE_POOL_SIZE=5

# Segurança
AUTH_SECRET=troque_por_64_caracteres_hex
INTEGRATION_MASTER_KEY=troque_por_openssl_rand_hex_32
INTEGRATION_KEY_VERSION=v1
METRICS_TOKEN=troque_por_openssl_rand_hex_32
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Anti-bot (Cloudflare Turnstile). Deixe false até cadastrar o site no Turnstile.
TURNSTILE_REQUIRED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=

# E-mail de recuperação de senha (opcional; preencher os três ou nenhum)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Tuya / Ekaza (vazio = modo demonstração)
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=us

# Opcionais
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
